          "id": "48b2390c-25fb-48f5-aa79-7597a593f79b",
          "name": "Get Supported Platforms",
          "request": {
            "name": "Get Supported Platforms",
            "description": {
              "content": "Get list of currently supported platform IDs.\n\nThis endpoint returns which platforms have releases available for download.\nThe frontend uses this to gray out unsupported platforms in the download UI.\n\nThis is public data for the marketing download page, so no authentication\nis required. CDN-friendly caching is enabled to reduce backend load.\n\nReturns:\n    SupportedPlatformsResponse with list of supported platform IDs\n\nExample:\n    GET /v1/releases/supported-platforms\n\n    Response:\n    {\n        \"supported\": [\n            \"macos-intel\",\n            \"macos-apple-silicon\",\n            \"windows-x64\",\n            \"linux-x64\"\n        ]\n    }",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "releases",
                "supported-platforms"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "11e78316-90af-4c4d-bfe3-ee1a15db8011",
              "name": "Successful Response",
              "originalRequest": {
                "url": {
