        {
          "id": "a5f07609-504a-420c-8941-70b7d90637dc",
          "name": "Discover",
          "request": {
            "name": "Discover",
            "description": {
              "content": "Email-domain SSO routing.\n\nLooks up whether the email's domain belongs to a WorkOS Organization\nthat's wired to one of our ``Organization`` rows. Returns the org\nslug + the ``/start`` URL the caller should redirect to. Returns\n``{org_slug: null, login_url: null}`` when no SSO is configured for\nthe domain — the caller falls back to global Google login.\n\nWhen the caller supplies ``frontend_origin``, it must match\n``ALLOWED_FRONTEND_ORIGINS`` and is round-tripped into ``login_url``\nso hosted browser callers can redirect to ``/start`` without\nrebuilding the query string themselves.\n\nWorkOS is the source of truth for ``OrganizationDomain``; we keep no\nlocal copy. One WorkOS API call per discover, which is acceptable\nsince users only click \"Continue with SSO\" at most once per login.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "auth",
                "workos",
                "discover"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "email",
                  "value": "<string>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "frontend_origin",
                  "value": "<string>"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
