          "name": "Get Account Features",
          "request": {
            "name": "Get Account Features",
            "description": {
              "content": "Get feature eligibility flags for the authenticated account.\n\nAuthenticates via session token (JWT/cookie) or API key.\nReturns plan-based entitlements; omitted keys are unavailable.  The\n``is_admin`` flag is surfaced separately so the desktop can grant\nQuadrillion staff access to every gated feature via a single, explicit\noverride rather than piggybacking on ``ollama``.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "account",
                "features"
