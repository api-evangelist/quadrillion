          "name": "Proxy Response Gemini",
          "request": {
            "name": "Proxy Response Gemini",
            "description": {
              "content": "Proxy Gemini API requests. Requires valid Quadrillion API key.\n\nThe Gemini SDK puts the model name in the URL path rather than the\nJSON body.  We stash it on ``request.state`` so that\n``proxy_response`` can inject it into the payload for downstream\nURL construction.",
              "type": "text/plain"
            },
